{
  "name": "@9oob/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/modal/modal.css",
      "default": "./dist/modal/modal.css"
    },
    "./wordmark": {
      "source": "./src/modal/wordmark.tsx",
      "types": "./src/modal/wordmark.tsx",
      "import": "./dist/modal/wordmark.js",
      "default": "./dist/modal/wordmark.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@9oob/schema": "workspace:^",
    "@hiero-ledger/sdk": "2.79.0",
    "lucide-react": "1.49.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.50",
    "@types/react": "^19.0.7",
    "react": "^19.2.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
