{
  "name": "9oob",
  "description": "Embed natural language onchain actions in your Hedera app.",
  "version": "0.1.0",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"],
      "packageManager": ["yarn"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "requirements": {
      "node": ">=22.12.0",
      "yarn": "3.2.3"
    },
    "outro": {
      "sections": [
        {
          "title": "Start 9oob",
          "steps": [
            { "command": "{run:setup}" },
            {
              "text": "Set your OpenAI key and database in server/.env, and your Reown project ID in packages/nextjs/.env.local. See README.md for setup and testnet funding."
            },
            { "command": "{run:next:dev}" },
            { "url": "http://localhost:3000/demo" }
          ]
        }
      ]
    }
  }
}
